Options -MultiViews -Indexes
RewriteEngine On
RewriteBase /

# Redirect non-www to www
RewriteCond %{HTTP_HOST} ^moudevpro\.com [NC]
RewriteRule ^(.*)$ https://www.moudevpro.com/$1 [R=301,L]

# Legacy URLs - 301 to their current pages
RewriteRule ^agence-web-marrakech/?$ /marrakech [R=301,L]
RewriteRule ^agence-web-rabat/?$ /rabat [R=301,L]
RewriteRule ^agence-web-tanger/?$ / [R=301,L]

# Canonical URL form: no trailing slash.
#
# The prerender writes dist/<route>/index.html, so every route is a real
# directory on disk. Left alone, mod_dir 301s /rabat to /rabat/ - which
# contradicts the canonical tags, sitemap, internal links and Ads final URLs,
# all of which use the unslashed form. Google saw both variants and kept
# switching which one it indexed. These two rules make the server agree with
# what the site already declares.
#
# DirectorySlash Off stops mod_dir from adding the slash back, which would
# otherwise ping-pong against the strip rule below. -Indexes above is required
# with it: without mod_dir's redirect, a directory request that misses the
# rewrite would fall through to a listing.
DirectorySlash Off

# 1. Strip the trailing slash. "^(.+)/$" cannot match the site root (the
#    per-directory pattern is empty there), so "/" is left alone.
RewriteRule ^(.+)/$ /$1 [R=301,L]

# 2. Serve the prerendered index for the unslashed form, internally. This runs
#    in mod_rewrite's fixup, before mod_dir would ever see a directory request,
#    so it holds even if the host ignores DirectorySlash.
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.+?)/?$ /$1/index.html [L]

# Unknown URLs: a real 404, not an SPA fallback.
#
# Every route is prerendered (prerender.js fails the build if one is missing),
# so there is nothing left for a "serve index.html for anything" rule to catch -
# it only turned typos and dead links into 200 copies of the homepage (soft
# 404s, with the homepage canonical). 404.html is the prerendered NotFoundPage
# (noindex); the bundle boots on it and React Router renders the same page.
ErrorDocument 404 /404.html

# Correct MIME type for sitemap
<FilesMatch "sitemap\.xml$">
  Header set Content-Type "application/xml; charset=utf-8"
</FilesMatch>

# ---------------------------------------------------------------------------
# MIME types the host does not know
#
# This server has no mapping for .avif and serves it as text/plain. That is not
# cosmetic: text/plain is in the compression list below, so every AVIF was being
# gzip-recompressed (317 KB of already-compressed data per request), and
# ExpiresByType image/avif never matched, so they were served with no cache
# header at all. hero-img.avif is the mobile LCP element. Verified live on
# 2026-08-14. .webp is already mapped correctly by the host.
# ---------------------------------------------------------------------------
AddType image/avif .avif
# Self-hosted Rubik (public/fonts/) - same host, same risk of an unknown type.
AddType font/woff2 .woff2

# ---------------------------------------------------------------------------
# Compression
#
# Text only. Images here are already AVIF/WebP and re-compressing them costs
# CPU for nothing. Every block below is IfModule-guarded: if the host lacks the
# module the directives are skipped rather than 500ing the whole site, which
# matters because these rules have not been run against a live Apache.
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE application/rss+xml image/svg+xml
  AddOutputFilterByType DEFLATE font/woff2 font/woff application/font-woff
</IfModule>

# ---------------------------------------------------------------------------
# Cache headers
#
# Three tiers, set by how the file is named rather than by type:
#
#   /assets/*  Vite writes a content hash into the filename (index-D5w8ol8c.css),
#              so a changed file is a new URL. Safe to cache for a year and mark
#              immutable - the browser then skips even the revalidation request.
#
#   images     NOT hashed - hero-img.avif keeps its name across deploys. A year
#              would pin a stale image in visitors' browsers with no way to bust
#              it short of renaming the file. 30 days bounds the staleness.
#
#   HTML       Never cached hard. Deploys here are a manual upload, and the
#              prerendered HTML carries the titles, meta and JSON-LD - an SEO
#              fix must take effect on the next request, not in a month.
#              no-cache still permits a 304, so this is cheap.
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/avif                "access plus 30 days"
  ExpiresByType image/webp                "access plus 30 days"
  ExpiresByType image/png                 "access plus 30 days"
  ExpiresByType image/jpeg                "access plus 30 days"
  ExpiresByType image/svg+xml             "access plus 30 days"
  ExpiresByType image/x-icon              "access plus 30 days"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType font/woff                 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Hashed build output - filename changes when content changes.
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Prerendered HTML - always revalidate.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # sitemap.xml and robots.txt change when pages do; keep them short.
  <FilesMatch "^(sitemap\.xml|robots\.txt|llms\.txt)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>
